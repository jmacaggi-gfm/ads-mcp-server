# ============================================================
# ads-mcp-server credentials
# ============================================================
# Two ways to load:
#  (1) Copy this file to .env in this directory
#  (2) Set ADS_MCP_ENV_FILE=/absolute/path/to/.env (e.g. point at
#      ~/marketing-ds/decision_science/.env if creds already live there)

# ----------------------------------------------------------------
# Google Ads API
# Setup: https://developers.google.com/google-ads/api/docs/get-started/dev-token
# OAuth refresh token: run google-ads-python's generate_user_credentials.py
# ----------------------------------------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Comma-separated list of customer IDs (no dashes). Server loops all.
# Example: 1234567890,9876543210
GOOGLE_ADS_CUSTOMER_IDS=
# MCC (manager) account ID, no dashes. Required when using cross-account access.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ----------------------------------------------------------------
# Meta Marketing API
# Setup: https://developers.facebook.com/docs/marketing-api/get-started
# Long-lived system user token: https://business.facebook.com → System Users
# ----------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
# Format: act_XXXXXXXXX
META_AD_ACCOUNT_ID=
# Conversion event name as it appears in Meta. Filter applied on actions[].
# Example: offsite_conversion.custom.StartFundraiser
META_CONVERSION_EVENT_NAME=offsite_conversion.fb_pixel_purchase

# ----------------------------------------------------------------
# Campaign classification keywords (comma-separated, case-insensitive)
# ----------------------------------------------------------------
BRAND_CAMPAIGN_KEYWORDS=brand,gofundme,branded
PMAX_KEYWORDS=pmax,performance max,pmaximizer

# ----------------------------------------------------------------
# Diagnosis thresholds (defaults shown)
# ----------------------------------------------------------------
BUDGET_UTIL_THRESHOLD=0.95
CPA_RESTRICTING_THRESHOLD=0.90
CPA_HEADROOM_THRESHOLD=0.70

# ----------------------------------------------------------------
# Cache TTL (seconds). Default 3600 = 1 hour.
# ----------------------------------------------------------------
CACHE_TTL_SECONDS=3600
